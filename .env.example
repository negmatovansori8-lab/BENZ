# Local development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=8
FX_USD_TJS=10.92
FX_USD_EUR=0.92
FX_USD_RUB=91.50

